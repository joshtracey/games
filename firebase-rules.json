{
  "rules": {
    ".read": false,
    ".write": false,
    "boggle": {
      "solo": {
        "$size": {
          ".read": true,
          ".indexOn": ["score"],
          "$name": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['name', 'score', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 5000 && newData.child('at').isNumber()"
          }
        }
      },
      "daily": {
        "days": {
          "$date": {
            ".read": true,
            ".indexOn": ["score"],
            "$name": {
              ".write": "auth != null",
              ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['name', 'score', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 5000 && newData.child('at').isNumber()"
            }
          }
        },
        "best": {
          ".read": true,
          ".indexOn": ["score"],
          "$name": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['name', 'score', 'date']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('score').isNumber() && newData.child('date').isString()"
          }
        },
        "history": {
          "$name": {
            ".read": true,
            "$date": {
              ".write": "auth != null",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            }
          }
        }
      },
      "rooms": {
        "$code": {
          ".read": true,
          ".write": "auth != null",
          ".validate": "$code.matches(/^[A-Z]{3}$/)"
        }
      }
    },
    "scattergories": {
      "daily": {
        "days": {
          "$date": {
            ".read": true,
            "$name": {
              ".write": "auth != null && !data.exists()",
              ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['name', 'at'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "answers": {
                "$slot": {
                  ".validate": "$slot.matches(/^c[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 40"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      },
      "rooms": {
        "$code": {
          ".read": true,
          ".write": "auth != null",
          ".validate": "$code.matches(/^[A-Z]{3}$/)"
        }
      }
    }
  }
}
